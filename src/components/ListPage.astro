---
// Trang danh sách một chuyên mục, có lọc theo chủ đề (chạy ngay trên trình duyệt, không tải lại trang).
import Base from '../layouts/Base.astro';
import PostRow from './PostRow.astro';
import PostTile from './PostTile.astro';
import { CATS, type Post } from '../lib/db';
interface Props { title: string; h1: string; intro: string; description: string; posts: Post[]; active: string; grid?: boolean }
const { title, h1, intro, description, posts, active, grid = false } = Astro.props;
const used = Object.keys(CATS).filter((c) => posts.some((p) => p.category === c));
---
<Base title={title} description={description} active={active}>
  <div class="wrap">
    <p class="crumb"><a href="/">Trang chủ</a> / {h1}</p>
    <h1>{h1}</h1>
    <p class="intro muted">{intro}</p>
    {used.length > 1 && (
      <div class="chips" role="group" aria-label="Lọc theo chủ đề">
        <button type="button" data-c="" aria-pressed="true">Tất cả <span>{posts.length}</span></button>
        {used.map((c) => <button type="button" data-c={c} aria-pressed="false">{CATS[c]} <span>{posts.filter((p) => p.category === c).length}</span></button>)}
      </div>
    )}
    <slot />
    {grid
      ? <div class="grid" id="list">{posts.map((p) => <div data-c={p.category}><PostTile p={p} /></div>)}</div>
      : <div class="list" id="list">{posts.map((p) => <div data-c={p.category}><PostRow p={p} /></div>)}</div>}
    {!posts.length && <p class="muted">Chuyên mục này mình đang viết bài đầu tiên. Các bác các bạn quay lại sau ít hôm nhé.</p>}
  </div>
  <style>
    .intro { max-width: 62ch; font-size: 17px; }
    .chips { display: flex; gap: 8px; overflow-x: auto; padding: 4px 0 12px; margin: 8px 0 4px; }
    .chips button { flex: none; font: 400 14.5px var(--text); border: 1px solid var(--line); background: #fff; color: var(--ink); padding: 7px 14px; border-radius: 999px; cursor: pointer; }
    .chips button span { color: var(--muted); font-size: 13px; }
    .chips button[aria-pressed="true"] { background: var(--sea); border-color: var(--sea); color: #fff; }
    .chips button[aria-pressed="true"] span { color: #CFE2EC; }
    .list { max-width: 820px; }
    .grid { display: grid; gap: 28px 20px; grid-template-columns: 1fr; margin-top: 10px; }
    @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  </style>
  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('.chips button');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('#list > div').forEach((d) => { d.hidden = !!b.dataset.c && d.dataset.c !== b.dataset.c; });
    }));
  </script>
</Base>
