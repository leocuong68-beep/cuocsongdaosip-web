---
// Dòng bài viết gọn: ảnh nhỏ bên trái, dễ lướt trên điện thoại.
import { CATS, fmtDate, postHref, type Post } from '../lib/db';
const { p, showCat = true } = Astro.props as { p: Post; showCat?: boolean };
---
<a class="row" href={postHref(p)}>
  {p.cover_url && <img src={p.cover_url} alt="" loading="lazy" width="160" height="110" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />}
  <span class="body">
    <span class="t">{p.title}</span>
    <span class="meta">{showCat && p.category && CATS[p.category] ? `${CATS[p.category]}, ` : ''}{fmtDate(p.published_at)}</span>
  </span>
</a>
<style>
  .row { display: grid; grid-template-columns: 112px 1fr; gap: 14px; align-items: start; padding: 14px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .row img { width: 112px; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--r-sm); background: var(--stone); }
  .t { display: block; font-weight: 500; font-size: 16px; line-height: 1.4; }
  .row:hover .t { color: var(--sea); }
  .meta { display: block; margin-top: 4px; font-size: 13.5px; color: var(--muted); }
  @media (min-width: 700px) { .row { grid-template-columns: 150px 1fr; } .row img { width: 150px; } .t { font-size: 17px; } }
</style>
