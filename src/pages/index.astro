---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import PostTile from '../components/PostTile.astro';
import EventItem from '../components/EventItem.astro';
import { getPosts, getEvents, SECTIONS } from '../lib/db';
import { AZ_LIST } from '../lib/az';
const posts = await getPosts();
const writing = posts.filter((p) => p.section !== 'video');
const lead = writing[0];
const news = posts.filter((p) => p.section === 'tin-tuc' && p.slug !== lead?.slug).slice(0, 5);
const life = posts.filter((p) => p.section === 'kinh-nghiem' && p.slug !== lead?.slug).slice(0, 8);
const videos = posts.filter((p) => p.section === 'video').slice(0, 8);
const today = new Date().toISOString().slice(0, 10);
const events = await getEvents();
const upcoming = events.filter((e) => (e.ends_on ?? e.starts_on) >= today).sort((a, b) => a.starts_on.localeCompare(b.starts_on)).slice(0, 4);
const recentEv = upcoming.length ? upcoming : events.slice(0, 3);
const letters = [...new Set(AZ_LIST.map((a) => a.letter))];
const FAQ: [string, string, string, string][] = [
  ['Cuộc sống ở Đảo Síp có đắt không?', 'Tuỳ thành phố bạn chọn. Limassol đắt nhất, nhất là tiền thuê nhà; Paphos, Larnaca dễ chịu hơn. Với nhà mình, khoản lớn nhất là tiền nhà và tiền điện mùa hè khi chạy điều hoà nhiều.', '/chi-phi-sinh-hoat-o-sip-2026-mot-thang-can-bao-nhieu/', 'Chi phí sinh hoạt ở Síp mỗi tháng'],
  ['Người Việt sang Síp sống có khó hoà nhập không?', 'Không quá khó. Tiếng Anh được dùng rộng rãi, đa số biển báo song ngữ Hy Lạp và Anh, người Síp thân thiện, nhịp sống chậm kiểu "siga siga". Có cộng đồng người Việt, nhất là ở Nicosia, Limassol và Paphos.', '/song-o-paphos-sip-chi-phi-truong-hoc-y-te-2026/', 'Sống ở Paphos thực tế ra sao'],
  ['Sống ở Síp có cần ô tô không?', 'Gần như cần. Xe buýt có nhưng thưa, Síp không có tàu hoả, nên đa số gia đình mua xe. Bằng lái Việt Nam chỉ dùng được một thời gian, sau đó phải đổi hoặc thi lại.', '/bang-lai-xe-o-sip-cho-nguoi-viet-2026-dung-bang-viet-nam-duoc-khong-thi-lai-the-nao/', 'Bằng lái xe ở Síp cho người Việt'],
  ['Khám chữa bệnh ở Síp thế nào?', 'Síp có hệ thống bảo hiểm y tế quốc gia GESY. Người cư trú hợp pháp đăng ký, chọn bác sĩ gia đình, đi khám theo giấy giới thiệu. Ngoài GESY vẫn có phòng khám tư.', '/y-te-o-sip-2026-he-thong-gesy-muc-dong-va-chi-phi-kham-chua-benh/', 'Y tế ở Síp và GESY'],
  ['Con cái đi học ở Síp ra sao?', 'Trường công miễn học phí và dạy bằng tiếng Hy Lạp; trường tư và trường quốc tế dạy bằng tiếng Anh, có học phí. Nhiều gia đình cho con nhỏ học trường công, con lớn học trường quốc tế.', '/truong-hoc-cho-con-o-sip-cong-lap-truong-quoc-te-hoc-phi-2026/', 'Trường học cho con ở Síp'],
  ['Khí hậu Síp có hợp người Việt không?', 'Nắng nhiều quanh năm. Hè từ khoảng tháng 5 tới tháng 10 nóng và khô, mùa đông ven biển ấm, mưa chủ yếu từ tháng 12 tới tháng 2. Người quen khí hậu miền Nam thường thấy dễ chịu.', '/khi-hau-thoi-tiet-sip-theo-mua-2026-nang-nong-mua-dong-han-han-nuoc/', 'Khí hậu và thời tiết Síp theo mùa'],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base title="Cuộc Sống Đảo Síp A-Z: kinh nghiệm thực tế cho người Việt" description="Cuộc sống Đảo Síp kể bởi một gia đình Việt ở Paphos: giá cả, điện nước, trường học, y tế, bằng lái, học tiếng Hy Lạp, tin tức, sự kiện và video thực tế." active="home" jsonld={faqLd}>
  <section class="hello">
    <div class="wrap">
      <div class="who">
        <img src="https://yt3.ggpht.com/aWfQPuiGKlc4NY0nJGndMZUM9x_iJAfrmGO41JrX50SZr_dO_XCr-Lm_5--6teoBf-AaYJ4l=s176-c-k-c0x00ffffff-no-rj" alt="Leo Cường" width="64" height="64" />
        <p>Mình là <b>Leo Cường</b>. Cả nhà mình chuyển từ Sài Gòn sang sống ở Paphos từ tháng 9/2025. Ở đây mình ghi lại chuyện giá cả, giấy tờ, trường lớp, thi cử và chỗ chơi cuối tuần, đúng như nhà mình đã trải qua. <a href="/gioi-thieu/">Đọc thêm về mình</a></p>
      </div>
      <h1>Cuộc sống Đảo Síp</h1>
      <p class="tag-line">Kinh nghiệm thực tế cho người Việt ở Síp, từ A tới Z</p>
    </div>
  </section>

  <div class="wrap">
    {lead && <div class="lead"><PostTile p={lead} big /></div>}

    <section class="study" aria-labelledby="study-h">
      <div class="study-head">
        <h2 id="study-h">Học &amp; thi ở Síp</h2>
        <p>Tự học miễn phí ngay trên điện thoại: biển báo để thi bằng lái, tiếng Hy Lạp để xin quốc tịch.</p>
      </div>
      <div class="study-cards">
        <a class="sc main" href="/hoc/bang-lai/">
          <img src="/hoc/bien-bao/Cyprus_road_sign_-_STOP.svg" alt="" width="64" height="64" />
          <span class="t">Biển báo &amp; trắc nghiệm bằng lái</span>
          <span class="d">170 biển báo có tên tiếng Việt, luyện tập và thi thử. Làm ngay, không cần đăng ký.</span>
          <span class="go">Học ngay</span>
        </a>
        <a class="sc" href="/hoc/tieng-hy-lap/">
          <span class="ab" aria-hidden="true">Αα</span>
          <span class="t">Học tiếng Hy Lạp</span>
          <span class="d">Mỗi ngày 30 phút, từ bảng chữ cái tới trình độ thi chứng chỉ. Đăng ký miễn phí.</span>
          <span class="go">Vào học</span>
        </a>
        <a class="sc soon" href="/hoc/">
          <span class="ab" aria-hidden="true">CY</span>
          <span class="t">Thi thử quốc tịch</span>
          <span class="d">Câu hỏi văn hoá, xã hội Síp theo đề cương thi. Sắp có.</span>
          <span class="go">Xem Khu Học</span>
        </a>
      </div>
    </section>

    <section class="az" aria-labelledby="az-h">
      <div class="sec-head"><h2 id="az-h">Sổ tay A-Z</h2><a href="/a-z/">Xem cả sổ tay</a></div>
      <p class="muted">Tra nhanh theo việc cần làm. Mỗi chữ cái là một nhóm chuyện người mới sang hay hỏi.</p>
      <div class="rail">
        {letters.map((l) => {
          const items = AZ_LIST.filter((a) => a.letter === l);
          return (
            <a class="key" href={`/a-z/#${items[0].id}`}>
              <span class="L">{l}</span>
              <span class="terms">{items.map((a) => a.term).join(', ')}</span>
            </a>
          );
        })}
      </div>
    </section>

    <div class="two">
      <section aria-labelledby="news-h">
        <div class="sec-head"><h2 id="news-h">Tin mới</h2><a href="/tin-tuc/">Tất cả tin</a></div>
        {news.map((p) => <PostRow p={p} showCat={false} />)}
      </section>
      <section aria-labelledby="ev-h">
        <div class="sec-head"><h2 id="ev-h">{upcoming.length ? 'Sắp diễn ra' : 'Sự kiện gần đây'}</h2><a href="/su-kien/">Lịch sự kiện</a></div>
        {recentEv.map((e) => <EventItem e={e} />)}
        {!upcoming.length && <p class="muted small">Mình đang cập nhật lịch tháng tới. Có sự kiện hay ở chỗ bạn thì nhắn mình nhé.</p>}
      </section>
    </div>

    <section aria-labelledby="life-h">
      <div class="sec-head"><h2 id="life-h">Kinh nghiệm sống</h2><a href="/kinh-nghiem/">Xem hết</a></div>
      <div class="scroller">{life.map((p) => <div class="cell"><PostTile p={p} /></div>)}</div>
    </section>

    <section aria-labelledby="vid-h">
      <div class="sec-head"><h2 id="vid-h">Video mới trên kênh</h2><a href="/video/">Tất cả video</a></div>
      <div class="scroller">{videos.map((p) => <div class="cell"><PostTile p={p} /></div>)}</div>
    </section>

    <section class="about" aria-labelledby="about-h">
      <h2 id="about-h">Cuộc sống ở Đảo Síp ra sao?</h2>
      <p>Síp là một đảo nhỏ ở phía đông Địa Trung Hải, thành viên Liên minh châu Âu từ 2004, dùng đồng euro từ 2008. Nhà mình sống ở Paphos từ tháng 9/2025. Sau hơn một năm, cuộc sống Đảo Síp với nhà mình gói trong mấy chữ: chậm, yên, nắng và gần biển. Đi đâu cũng cần xe, giấy tờ phải kiên nhẫn, mùa hè rất nóng, nhưng con được học trong môi trường đa quốc tịch và cả nhà có nhiều thời gian cho nhau hơn.</p>
      <p>Blog này ghi lại những gì nhà mình làm thật: <a href="/kinh-nghiem/">kinh nghiệm sống</a> (giá cả, điện nước, ngân hàng, trường lớp), <a href="/tin-tuc/">tin tức Đảo Síp</a> đáng chú ý, <a href="/su-kien/">sự kiện cuối tuần</a>, chuyện <a href="/hoc/">học tiếng Hy Lạp, thi bằng lái, quốc tịch</a> và <a href="/video/">video</a> trên kênh Cường Đảo Síp. Mới sang thì bắt đầu từ <a href="/a-z/">sổ tay A-Z</a>.</p>
    </section>

    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Hỏi nhanh về cuộc sống Đảo Síp</h2>
      {FAQ.map(([q, a, href, label]) => (
        <details>
          <summary>{q}</summary>
          <p>{a} <a href={href}>{label}</a></p>
        </details>
      ))}
    </section>


  </div>

  <style>
    .hello { background: var(--stone); padding: 22px 0 26px; }
    .who { display: flex; gap: 14px; align-items: flex-start; max-width: 720px; }
    .who img { width: 56px; height: 56px; border-radius: 50%; flex: none; border: 2px solid #fff; }
    .who p { margin: 0; font-size: 15.5px; }
    .hello h1 { margin: 20px 0 0; }
    .study { margin-top: 34px; background: var(--sea); border-radius: var(--r-lg); padding: 22px 18px 20px; color: #E3EEF4; }
    .study-head h2 { color: #fff; margin: 0 0 4px; }
    .study-head p { margin: 0 0 16px; font-size: 15.5px; }
    .study-cards { display: grid; gap: 10px; }
    @media (min-width: 800px) { .study { padding: 28px; } .study-cards { grid-template-columns: 1.3fr 1fr 1fr; } }
    .sc { display: grid; grid-template-columns: 56px 1fr; grid-template-rows: auto auto auto; column-gap: 14px; row-gap: 4px; align-items: start; background: #fff; color: var(--ink); border-radius: 14px; padding: 16px; text-decoration: none; }
    .sc img, .sc .ab { grid-row: 1 / span 3; width: 56px; height: 56px; }
    .sc .ab { display: grid; place-items: center; border-radius: 12px; background: var(--stone); color: var(--sea); font-family: var(--display); font-weight: 700; font-size: 22px; }
    .sc .t { font-family: var(--display); font-weight: 600; font-size: 18.5px; line-height: 1.25; }
    .sc .d { font-size: 14.5px; color: var(--muted); line-height: 1.45; }
    .sc .go { font-size: 14.5px; font-weight: 500; color: var(--sea); margin-top: 4px; }
    .sc.main { box-shadow: inset 0 0 0 2px var(--copper); }
    .sc.main .go { color: var(--copper); }
    .sc.soon { opacity: .85; }
    .sc:hover .t { color: var(--sea); }
    .tag-line { font-size: 18px; color: var(--muted); margin: 6px 0 0; }
    .about { max-width: 760px; margin-top: 44px; }
    .about p { font-size: 17px; }
    .faq { max-width: 760px; margin-top: 28px; }
    .faq details { border-bottom: 1px solid var(--line); padding: 4px 0; }
    .faq summary { cursor: pointer; padding: 12px 0; font-weight: 500; font-size: 16.5px; list-style: none; }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after { content: '+'; float: right; color: var(--sea); font-size: 20px; line-height: 1; }
    .faq details[open] summary::after { content: '–'; }
    .faq details p { margin: 0 0 14px; color: var(--ink); }

    .lead { margin-top: 26px; }

    .az .muted { margin-top: -6px; }
    .rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 1fr); gap: 0; overflow-x: auto; scroll-snap-type: x mandatory; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
    .key { scroll-snap-align: start; display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; text-decoration: none; color: var(--ink); border-right: 1px solid var(--line); min-height: 132px; }
    .key:hover { background: var(--stone); }
    .L { font-family: var(--display); font-weight: 700; font-size: 54px; line-height: 1; color: var(--copper); font-variation-settings: 'opsz' 144; }
    .terms { font-size: 14px; line-height: 1.4; color: var(--muted); }
    .key:hover .terms { color: var(--ink); }

    .two { display: grid; gap: 0 48px; }
    @media (min-width: 900px) { .two { grid-template-columns: 1.4fr 1fr; } }

    .scroller { display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; -webkit-overflow-scrolling: touch; }
    .cell { scroll-snap-align: start; }
    @media (min-width: 700px) { .scroller { grid-auto-columns: 40%; } }
    @media (min-width: 1000px) { .scroller { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; } }

    .learn { display: grid; gap: 8px 40px; margin-top: 44px; }
    .learn .box { background: var(--sea); color: #E3EEF4; border-radius: var(--r-lg); padding: 24px 22px; }
    .learn .box h2 { color: #fff; }
    .learn .box .btn { background: #fff; color: var(--sea); }
    @media (min-width: 900px) { .learn { grid-template-columns: 1fr 1fr; align-items: start; } }
  </style>
</Base>
