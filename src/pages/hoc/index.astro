---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { bySection } from '../../lib/db';
const posts = await bySection('hoc-tap');
---
<Base image="https://www.cuocsongdaosip.com/og/tieng-hy-lap.jpg" title="Học tiếng Hy Lạp, biển báo bằng lái, thi quốc tịch ở Đảo Síp" description="Học tiếng Hy Lạp cho người Việt ở Síp, kinh nghiệm thi bằng lái và thi quốc tịch Síp. Khu Học miễn phí, mở cho bạn đọc đã đăng ký và được duyệt." active="hoc">
  <div class="wrap hoc">
    <p class="crumb"><a href="/">Trang chủ</a> / Học & thi</p>
    <h1>Học tiếng Hy Lạp, bằng lái, quốc tịch</h1>
    <p class="muted" style="font-size:17px">Mình soạn bộ bài tiếng Hy Lạp cho người Việt ở Síp: ai cần thi quốc tịch, hay chỉ muốn đi chợ, nói chuyện với hàng xóm đều học được. Khu Học miễn phí, mỗi tài khoản mình duyệt tay để giữ nhóm học nhỏ và nghiêm túc.</p>


    <section class="study" aria-labelledby="study-h">
      <h2 id="study-h">Chọn phần muốn học</h2>
      <p>Một tài khoản, một lần duyệt là học được cả ba phần.</p>
      <div class="study-cards">
        <a class="sc main" href="/hoc/bang-lai/">
          <img src="/hoc/bien-bao/Cyprus_road_sign_-_STOP.svg" alt="" width="64" height="64" />
          <span class="t">Biển báo &amp; trắc nghiệm bằng lái</span>
          <span class="d">170 biển báo giao thông Síp có tên tiếng Việt, học theo nhóm rồi làm trắc nghiệm luyện tập hoặc thi thử.</span>
          <span class="go">Học biển báo</span>
        </a>
        <a class="sc" id="c-greek" href="/hoc/tieng-hy-lap/">
          <span class="ab" aria-hidden="true">Αα</span>
          <span class="t">Học tiếng Hy Lạp</span>
          <span class="d">Bản thử nghiệm: bảng chữ cái và 4 tuần A1 đầu, mỗi ngày 30 phút. Nghe, nói, đọc, viết, kèm kiến thức về Síp.</span>
          <span class="go">Vào học</span>
        </a>
        <a class="sc" href="/hoc/quoc-tich/">
          <span class="ab" aria-hidden="true">CY</span>
          <span class="t">Thi thử quốc tịch</span>
          <span class="d">Ôn ở đâu, cách thi, cách chấm, khi nào có kết quả, kèm đề thi thử 25 câu trong 45 phút.</span>
          <span class="go">Xem và thi thử</span>
        </a>
      </div>
    </section>

    <div id="st" class="state" aria-live="polite"><p class="muted">Đang kiểm tra tài khoản…</p></div>

    {posts.length > 0 && <><h2 style="margin-top:36px">Bài viết về học và thi</h2>{posts.map((p) => <PostRow p={p} showCat={false} />)}</>}
    <p class="note">Nội dung học là tài liệu tự soạn, đang được soát lại. Thông tin chính thức về các kỳ thi do cơ quan tổ chức thi công bố.</p>
  </div>
  <style>
    .state { margin: 20px 0; background: var(--stone); border-radius: var(--r-lg); padding: 18px 20px; }
    .state :global(h3) { margin: 0 0 6px; }
    .state :global(p:last-child) { margin-bottom: 0; }
    .state :global(textarea) { width: 100%; min-height: 76px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; font: inherit; margin: 6px 0 12px; background: #fff; }
    .state :global(.err) { color: #B3261E; font-size: 14px; }
    .hoc > p, .hoc > h1, .hoc .state, .hoc > h2, .hoc .note { max-width: 760px; }
    .study { margin: 26px 0 8px; background: var(--sea); border-radius: var(--r-lg); padding: 22px 18px 20px; color: #E3EEF4; }
    .study h2 { color: #fff; margin: 0 0 4px; }
    .study > p { margin: 0 0 16px; font-size: 15.5px; }
    .study-cards { display: grid; gap: 10px; }
    @media (min-width: 800px) { .study { padding: 28px; } .study-cards { grid-template-columns: 1.3fr 1fr 1fr; } }
    .sc { display: grid; grid-template-columns: 56px 1fr; grid-template-rows: auto auto auto; column-gap: 14px; row-gap: 4px; align-items: start; background: #fff; color: var(--ink); border-radius: 14px; padding: 16px; text-decoration: none; }
    .sc img, .sc .ab { grid-row: 1 / span 3; width: 56px; height: 56px; }
    .sc .ab { display: grid; place-items: center; border-radius: 12px; background: var(--stone); color: var(--sea); font-family: var(--display); font-weight: 700; font-size: 22px; }
    .sc .t { font-family: var(--display); font-weight: 600; font-size: 18.5px; line-height: 1.25; }
    .sc .d { font-size: 14.5px; color: var(--muted); line-height: 1.45; }
    .sc .go { font-size: 14.5px; font-weight: 500; color: var(--sea); margin-top: 4px; }
    .sc.main { box-shadow: inset 0 0 0 2px var(--copper); }
    .sc.main .go { color: var(--copper); }
    .sc:hover .t { color: var(--sea); }
  </style>
  <script>
    import { hocState, requestAccess } from '../../lib/hoc';
    import { loginHref } from '../../lib/member';
    const st = document.getElementById('st')!;
    const greek = document.getElementById('c-greek') as HTMLAnchorElement;
    async function render() {
      const s = await hocState();
      const hi = s.name ? `Chào ${s.name.replace(/[<>&"]/g, '')}. ` : '';
      if (s.status === 'guest') {
        greek.href = loginHref('/hoc/');
        st.innerHTML = `<h3>Đăng nhập để vào học</h3><p>Bạn đăng ký miễn phí (họ tên, nơi ở, email, số điện thoại), rồi gửi yêu cầu vào Khu Học ngay tại trang này. Một lần duyệt là học được tiếng Hy Lạp, bằng lái và thi thử quốc tịch.</p><p><a class="btn" href="${loginHref('/hoc/')}">Đăng ký hoặc đăng nhập</a></p>`;
      } else if (s.status === 'none') {
        greek.href = '#st';
        st.innerHTML = `<h3>${hi}Gửi yêu cầu vào Khu Học</h3><p>Mình xem và duyệt từng tài khoản. Bạn có thể ghi vài dòng về mình (không bắt buộc).</p><textarea id="note" maxlength="500" placeholder="Ví dụ: nhà mình ở Limassol, muốn học để thi quốc tịch."></textarea><p class="err" id="err" role="alert"></p><button class="btn" id="req" type="button">Gửi yêu cầu</button>`;
        document.getElementById('req')!.onclick = async (e) => {
          const b = e.currentTarget as HTMLButtonElement; b.disabled = true;
          const err = await requestAccess((document.getElementById('note') as HTMLTextAreaElement).value);
          if (err) { document.getElementById('err')!.textContent = err; b.disabled = false; return; }
          render();
        };
      } else if (s.status === 'pending') {
        greek.href = '#st';
        st.innerHTML = `<h3>${hi}Yêu cầu của bạn đang chờ duyệt</h3><p>Hồ sơ đủ thông tin thường được duyệt trong vài tiếng (ban ngày giờ Síp). Cần gấp thì nhắn mình qua WhatsApp/Zalo +357 94 100 091.</p>`;
      } else if (s.status === 'rejected') {
        greek.href = '#st';
        st.innerHTML = `<h3>Tài khoản chưa được mở Khu Học</h3><p>Bạn nhắn mình qua WhatsApp/Zalo +357 94 100 091 nhé.</p>`;
      } else {
        st.innerHTML = `<h3>${hi}Tài khoản đã được duyệt</h3><p><a class="btn" href="/hoc/tieng-hy-lap/">Tiếng Hy Lạp</a> <a class="btn ghost" href="/hoc/bang-lai/">Bằng lái</a> <a class="btn ghost" href="/hoc/quoc-tich/#thi-thu">Thi thử quốc tịch</a>${s.staff ? ' <a class="btn ghost" href="/hoc/quan-tri/">Duyệt tài khoản</a>' : ''}</p>`;
      }
    }
    render();
  </script>
</Base>
